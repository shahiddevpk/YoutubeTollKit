# Copy to `.env.local` for local development. Do not commit real secrets.

# YouTube Data API v3 (public channel/video lookups)
YOUTUBE_API_KEY=

# Visitor daily rate limit per IP (default: 20 requests/day to protect the free 10,000 units quota)
DAILY_API_LIMIT=20

# Canonical site URL (required for correct OAuth return URLs in production)
# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth — owner-only monetization verification (optional until you test that flow)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match a redirect URI authorized in Google Cloud (add localhost for local testing):
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/monetization/callback

# HMAC secret for signed OAuth state and verification cookies (min 32 characters)
YOUTUBE_OAUTH_STATE_SECRET=
